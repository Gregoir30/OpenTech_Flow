---

<!-- PORTFOLIO -->
<section id="portfolio" class="portfolio-section" aria-label="Portfolio">
  <div class="container">
    <div class="section-label">Portfolio</div>
    <h2 class="section-title">Mes réalisations</h2>
    <p class="section-desc">Une sélection de projets où la technique rencontre les besoins utilisateurs réels.</p>
    <ul class="portfolio-filters" role="tablist">
      <li data-filter="*" class="active" role="tab">Tous</li>
      <li data-filter="web" role="tab">Développement Web</li>
      <li data-filter="network" role="tab">Réseau &amp; Sécurité</li>
      <li data-filter="misc" role="tab">Projets Innovants</li>
    </ul>
    <div class="portfolio-grid" id="portfolio-grid">
      {projects.map((project) => (
        <ProjectCard {...project} />
      ))}
    </div>
  </div>
</section>
