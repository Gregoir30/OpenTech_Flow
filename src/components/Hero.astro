---
import { withBase } from '../utils/urls';
---

<!-- KINGFISHER HERO SECTION -->
<section id="home" class="hero hero-kingfisher" aria-label="Introduction">
  <video id="hero-video" class="hero-video" muted playsinline preload="auto">
    <source src={withBase("asset/video/hero.mp4")} type="video/mp4" />
    <source src="https://thinkingods.com/demos/kingfisher-hero/hero.mp4" type="video/mp4" />
  </video>

  <!-- Giant word behind the bird with mix-blend-mode: darken -->
  <div class="hero-word" aria-hidden="true">Open<em>Tech</em><br />Flow</div>

  <!-- Legibility Overlay -->
  <div class="hero-overlay" aria-hidden="true"></div>

  <!-- Interactive UI Layer -->
  <div class="hero-ui">
    <!-- Center Stage Grid -->
    <div class="hero-main">
      <!-- Left Copy: pushed down to clear giant word -->
      <div class="hero-copy">
        <div class="hero-badge-wrap rv" style="--d: 1;">
          <div class="kingfisher-badge">
            <span class="badge-dot" aria-hidden="true"></span>
            <span>DÉVELOPPEMENT WEB · APPLICATIONS MÉTIER · SOLUTIONS NUMÉRIQUES</span>
          </div>
        </div>

        <h1 class="hero-title rv" style="--d: 2;">
          Transformez vos idées en solutions numériques <span class="highlight">utiles à votre activité.</span>
        </h1>

        <p class="hero-lede rv" style="--d: 3;">
          Je conçois des sites web professionnels et des applications métier sur mesure pour aider les entreprises, les organisations et les entrepreneurs à mieux gérer leurs activités, servir leurs clients et développer leur présence numérique.
        </p>

        <div class="hero-author-tag rv" style="--d: 3;">
          <strong>Grégoir SABA</strong> — Développeur web et mobile | Fondateur d’OpenTech Flow, Lomé, Togo.
        </div>

        <div class="hero-actions rv" style="--d: 4;">
          <a href="#contact" class="btn-primary" style="font-weight:700;letter-spacing:0.02em;">
            <i class="bi bi-chat-dots-fill"></i> Discutons de votre projet
          </a>
          <a href="#portfolio" class="btn-secondary" style="font-weight:600;">
            <i class="bi bi-grid-fill"></i> Découvrir mes réalisations
          </a>
        </div>

        <div class="hero-quick-contact rv" style="--d: 4;">
          <button class="chip-copy" onclick="copyContact('contact@gregoirservices.tg')" title="Cliquer pour copier l'email">
            <i class="bi bi-envelope-fill"></i> contact@gregoirservices.tg <i class="bi bi-copy copy-icon"></i>
          </button>
          <button class="chip-copy" onclick="copyContact('+22890416117')" title="Cliquer pour copier le téléphone">
            <i class="bi bi-telephone-fill"></i> +228 90 41 61 17 <i class="bi bi-copy copy-icon"></i>
          </button>
        </div>
      </div>

      <!-- Hero Right: Photo with Cyber Rings and Stats -->
      <div class="hero-image-wrap rv" style="--d: 5;">
        <div class="hero-img-ring" aria-hidden="true"></div>
        <div class="hero-img-ring-2" aria-hidden="true"></div>
        <img
          src={withBase("asset/images/my_profile.png")}
          alt="Grégoir SABA — Développeur Web et Applications Métier à Lomé, Togo | Fondateur OpenTech Flow"
          class="hero-photo"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="400"
          height="380"
        />
        <div class="hero-stats">
          <div class="stat-chip"><strong>50+</strong><span>Projets</span></div>
          <div class="stat-chip"><strong>4+</strong><span>Années</span></div>
          <div class="stat-chip"><strong>10+</strong><span>Audits</span></div>
        </div>
      </div>
    </div>

    <!-- Bottom Strip -->
    <footer class="hero-strip rv" style="--d: 8;">
      <div class="strip-species">
        <span style="display:inline-flex;align-items:center;gap:6px;color:var(--accent);font-weight:700;">
          <i class="bi bi-camera-reels-fill"></i> 4K UHD
        </span>
        <span class="species-latin">KINGFISHER · CINÉMATIQUE</span>
        <span style="opacity:0.6;">· OpenTech Flow</span>
      </div>

      <div class="strip-location">
        LOMÉ · 6.2056° N — TOGO
      </div>

      <div class="strip-actions">
        <button class="btn-replay" id="hero-replay-btn" aria-label="Rejouer la séquence vidéo" title="Rejouer la vidéo haute définition">
          <svg width="12" height="12" viewBox="0 0 16 16" fill="none">
            <path d="M2.5 8C2.5 4.96243 4.96243 2.5 8 2.5C10.4287 2.5 12.4925 4.07436 13.2081 6.25M13.5 2V6.5H9"
              stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M13.5 8C13.5 11.0376 11.0376 13.5 8 13.5C5.5713 13.5 3.50754 11.9256 2.79193 9.75M2.5 14V9.5H7"
              stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span>Rejouer</span>
        </button>
        <a href="#about" class="hero-scroll-btn" aria-label="Défiler vers À propos">
          <i class="bi bi-chevron-down"></i>
        </a>
      </div>
    </footer>
  </div>
</section>

<script is:inline>
  (function () {
    const REVEAL_AT = 4.3;
    const video = document.getElementById('hero-video');
    const hero = document.getElementById('home');
    const replayBtn = document.getElementById('hero-replay-btn');
    let isRevealed = false;

    function triggerReveal() {
      if (isRevealed || !hero) return;
      isRevealed = true;
      hero.classList.add('is-revealed');
    }

    function replayHero() {
      if (!video || !hero) return;
      isRevealed = false;
      hero.classList.remove('is-revealed');
      video.currentTime = 0;
      const p = video.play();
      if (p !== undefined) {
        p.catch(() => triggerReveal());
      }
    }

    if (replayBtn) {
      replayBtn.addEventListener('click', replayHero);
    }

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) {
      if (video) video.currentTime = REVEAL_AT;
      triggerReveal();
      return;
    }

    if (video) {
      video.addEventListener('timeupdate', () => {
        if (video.currentTime >= REVEAL_AT && !isRevealed) {
          triggerReveal();
        }
      });

      video.addEventListener('ended', triggerReveal);
      video.addEventListener('error', triggerReveal);
      setTimeout(triggerReveal, 5500);

      const playAttempt = video.play();
      if (playAttempt !== undefined) {
        playAttempt.catch(() => triggerReveal());
      }
    }
  })();
</script>
