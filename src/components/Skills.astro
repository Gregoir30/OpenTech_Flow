<!-- SKILLS -->
<section id="skills" class="skills" aria-label="Compétences techniques">
  <div class="container">
    <div class="section-label">Compétences</div>
    <h2 class="section-title">Arsenal technique</h2>
    <p class="section-desc">Un stack complet pour répondre aux défis du web moderne et de la cybersécurité offensive
      &amp; défensive.</p>
    <div class="skills-layout">
      <div class="fade-in">
        <h3
          style="font-family:var(--font-display);font-size:0.85rem;color:var(--accent);letter-spacing:0.1em;text-transform:uppercase;margin-bottom:24px;">
          Développement</h3>
        <div class="skill-group">
          <div class="skill-header"><span>Flutter &amp; Dart</span><span>82%</span></div>
          <div class="skill-track">
            <div class="skill-fill" data-width="82"></div>
          </div>
        </div>
        <div class="skill-group">
          <div class="skill-header"><span>Firebase (Auth, Firestore, Storage)</span><span>80%</span></div>
          <div class="skill-track">
            <div class="skill-fill" data-width="80"></div>
          </div>
        </div>
        <div class="skill-group">
          <div class="skill-header"><span>Python (Scripting &amp; Sécurité)</span><span>80%</span></div>
          <div class="skill-track">
            <div class="skill-fill" data-width="80"></div>
          </div>
        </div>
        <div class="skill-group">
          <div class="skill-header"><span>PHP / Laravel</span><span>80%</span></div>
          <div class="skill-track">
            <div class="skill-fill" data-width="80"></div>
          </div>
        </div>
        <div class="skill-group">
          <div class="skill-header"><span>JavaScript (Node.js / React)</span><span>75%</span></div>
          <div class="skill-track">
            <div class="skill-fill" data-width="75"></div>
          </div>
        </div>
        <div class="skill-group">
          <div class="skill-header"><span>Java / J2EE</span><span>60%</span></div>
          <div class="skill-track">
            <div class="skill-fill" data-width="60"></div>
          </div>
        </div>

        <div class="skills-tags" style="margin-top:32px;">
          <span class="tag">Flutter</span><span class="tag">Firebase</span>
          <span class="tag">Dart</span><span class="tag">HTML5 / CSS3</span>
          <span class="tag">MySQL / Oracle</span><span class="tag">Docker</span>
          <span class="tag">Git</span><span class="tag">REST API</span>
        </div>
      </div>
      <div class="fade-in">
        <h3
          style="font-family:var(--font-display);font-size:0.85rem;color:var(--accent2);letter-spacing:0.1em;text-transform:uppercase;margin-bottom:24px;">
          Sécurité &amp; Réseaux</h3>
        <div class="skill-group">
          <div class="skill-header"><span>Linux / Kali Linux</span><span>90%</span></div>
          <div class="skill-track">
            <div class="skill-fill" data-width="90"></div>
          </div>
        </div>
        <div class="skill-group">
          <div class="skill-header"><span>Sécurité Réseau (Firewall / VPN)</span><span>85%</span></div>
          <div class="skill-track">
            <div class="skill-fill" data-width="85"></div>
          </div>
        </div>
        <div class="skill-group">
          <div class="skill-header"><span>Ethical Hacking / Pentesting</span><span>75%</span></div>
          <div class="skill-track">
            <div class="skill-fill" data-width="75"></div>
          </div>
        </div>
        <div class="skill-group">
          <div class="skill-header"><span>Analyse de vulnérabilités OWASP</span><span>75%</span></div>
          <div class="skill-track">
            <div class="skill-fill" data-width="75"></div>
          </div>
        </div>

        <div class="skills-tags" style="margin-top:32px;">
          <span class="tag">Wireshark</span><span class="tag">Metasploit</span>
          <span class="tag">Nmap</span><span class="tag">Burp Suite</span>
          <span class="tag">UFW / Fail2Ban</span><span class="tag">OSINT</span>
        </div>
      </div>
    </div>
  </div>
</section>
