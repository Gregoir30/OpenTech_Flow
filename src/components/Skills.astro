---
---

<!-- SKILLS -->
<section id="skills" class="skills" aria-label="Compétences techniques">
  <div class="container">
    <div class="section-label">Compétences</div>
    <h2 class="section-title">Stack technique &amp; Domaines d'intervention</h2>
    <p class="section-desc">Technologies éprouvées pour concevoir des applications web et métier robustes, complétées par une expertise en mobile et sécurité.</p>
    
    <div class="skills-layout">
      <!-- Cœur : Développement Web & Applications Métier -->
      <div class="fade-in">
        <h3
          style="font-family:var(--font-display);font-size:0.85rem;color:var(--accent);letter-spacing:0.1em;text-transform:uppercase;margin-bottom:24px;">
          Développement Web &amp; Applications Métier</h3>
        
        <div class="skill-group">
          <div class="skill-header"><span>PHP / Laravel</span><span style="color:var(--accent3);">Production &amp; APIs</span></div>
          <div class="skill-track">
            <div class="skill-fill" style="width: 100%; background: var(--accent);"></div>
          </div>
        </div>

        <div class="skill-group">
          <div class="skill-header"><span>JavaScript (Node.js &amp; React)</span><span style="color:var(--accent3);">Interfaces &amp; Services</span></div>
          <div class="skill-track">
            <div class="skill-fill" style="width: 100%; background: var(--accent);"></div>
          </div>
        </div>

        <div class="skill-group">
          <div class="skill-header"><span>Bases de Données (MySQL, PostgreSQL)</span><span style="color:var(--accent3);">Modélisation &amp; Requêtes</span></div>
          <div class="skill-track">
            <div class="skill-fill" style="width: 100%; background: var(--accent);"></div>
          </div>
        </div>

        <div class="skill-group">
          <div class="skill-header"><span>HTML5, CSS3 &amp; Tailwind CSS</span><span style="color:var(--accent3);">Responsive &amp; Design System</span></div>
          <div class="skill-track">
            <div class="skill-fill" style="width: 100%; background: var(--accent);"></div>
          </div>
        </div>

        <div class="skill-group">
          <div class="skill-header"><span>Python (Scripting, Automatisation &amp; API)</span><span style="color:var(--accent3);">Pratique active</span></div>
          <div class="skill-track">
            <div class="skill-fill" style="width: 100%; background: var(--accent);"></div>
          </div>
        </div>

        <div class="skills-tags" style="margin-top:32px;">
          <span class="tag">PHP 8+</span><span class="tag">Laravel</span>
          <span class="tag">Node.js</span><span class="tag">React</span>
          <span class="tag">MySQL</span><span class="tag">REST API</span>
          <span class="tag">Git &amp; GitHub</span><span class="tag">Docker</span>
        </div>
      </div>

      <!-- Spécialités complémentaires : Mobile, Cloud & Sécurité -->
      <div class="fade-in">
        <h3
          style="font-family:var(--font-display);font-size:0.85rem;color:var(--accent2);letter-spacing:0.1em;text-transform:uppercase;margin-bottom:24px;">
          Mobile, Cloud &amp; Sécurité (Spécialités complémentaires)</h3>

        <div class="skill-group">
          <div class="skill-header"><span>Flutter &amp; Dart</span><span style="color:var(--accent2);">Applications iOS &amp; Android</span></div>
          <div class="skill-track">
            <div class="skill-fill" style="width: 100%; background: var(--accent2);"></div>
          </div>
        </div>

        <div class="skill-group">
          <div class="skill-header"><span>Firebase (Auth, Firestore, Cloud Storage)</span><span style="color:var(--accent2);">BaaS &amp; Synchronisation</span></div>
          <div class="skill-track">
            <div class="skill-fill" style="width: 100%; background: var(--accent2);"></div>
          </div>
        </div>

        <div class="skill-group">
          <div class="skill-header"><span>Administration Linux (Debian, Ubuntu)</span><span style="color:var(--accent2);">Hardening, UFW &amp; Fail2Ban</span></div>
          <div class="skill-track">
            <div class="skill-fill" style="width: 100%; background: var(--accent2);"></div>
          </div>
        </div>

        <div class="skill-group">
          <div class="skill-header"><span>Sécurité Applicative &amp; Audits OWASP</span><span style="color:var(--accent2);">Analyse de vulnérabilités</span></div>
          <div class="skill-track">
            <div class="skill-fill" style="width: 100%; background: var(--accent2);"></div>
          </div>
        </div>

        <div class="skill-group">
          <div class="skill-header"><span>Réseaux d'Entreprise (VPN, VLAN, Cisco)</span><span style="color:var(--accent2);">Architecture sécurisée</span></div>
          <div class="skill-track">
            <div class="skill-fill" style="width: 100%; background: var(--accent2);"></div>
          </div>
        </div>

        <div class="skills-tags" style="margin-top:32px;">
          <span class="tag">Flutter</span><span class="tag">Dart</span>
          <span class="tag">Firebase</span><span class="tag">Linux</span>
          <span class="tag">OWASP Top 10</span><span class="tag">pfSense</span>
          <span class="tag">Wireshark</span><span class="tag">Burp Suite</span>
        </div>
      </div>
    </div>
  </div>
</section>
