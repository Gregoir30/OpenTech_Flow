<!-- ABOUT -->
<section id="about" class="about" aria-label="À propos">
  <div class="container">
    <div class="about-grid">
      <div class="about-text fade-in">
        <div class="section-label">À propos</div>
        <h2 class="section-title">Sécurité &amp; Innovation<br />comme fondation</h2>
        <p>
          Basé à <strong>Lomé, Togo</strong>, je suis un professionnel polyvalent naviguant entre le code et la
          sécurité des réseaux depuis plus de 4 ans. Mon approche repose sur un principe fondamental :
        </p>
        <p>
          <em>"La sécurité ne doit jamais être une option, mais une fondation."</em>
        </p>
        <p>
          J'accompagne les entreprises et particuliers dans leur <strong>transformation numérique</strong> tout en
          garantissant l'intégrité et la confidentialité de leurs données face aux menaces actuelles.
        </p>
        <div class="about-metrics">
          <div class="metric-card">
            <div class="num" data-count="50">0</div>
            <p>Projets livrés</p>
          </div>
          <div class="metric-card">
            <div class="num" data-count="10">0</div>
            <p>Audits réalisés</p>
          </div>
          <div class="metric-card">
            <div class="num" data-count="4">0</div>
            <p>Ans d'expérience</p>
          </div>
        </div>
      </div>
      <div class="about-visual fade-in">
        <div class="tech-orbit">
          <div class="orbit-ring orbit-1">
            <div class="orbit-item"><i class="bi bi-filetype-py"></i></div>
          </div>
          <div class="orbit-ring orbit-2">
            <div class="orbit-item"><i class="bi bi-shield-lock-fill"></i></div>
          </div>
          <div class="orbit-ring orbit-3">
            <div class="orbit-item"><i class="bi bi-gear-fill"></i></div>
          </div>
          <div class="orbit-center">FULL<br />STACK<br />+<br />CYBER</div>
        </div>
      </div>
    </div>
  </div>
</section>
